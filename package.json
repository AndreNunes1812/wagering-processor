{
  "name": "wagering-processor",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:load": "bun src/load/run.ts",
    "token": "bun src/auth/print-token.ts",
    "db:up": "bun src/database/migrate.ts",
    "db:down": "bun src/database/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1158.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "jose": "5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
